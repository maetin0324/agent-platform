[Unit]
# taskd-gui（ADR-0040 D4）。`%i` は リリースの sha12。`~/taskd/releases/<sha12>/gui/` から動く。
# 環境はいまの本番（`node server.js` を手で起こしていたもの）と同じ。
# インストール: scripts/selfdeploy/install-units.sh（~/.config/systemd/user/ に置いて daemon-reload）
Description=taskd-gui (release %i)
After=network.target taskd@%i.service
Wants=taskd@%i.service

[Service]
Type=simple
WorkingDirectory=%h/taskd/releases/%i/gui
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=TASKD_GUI_BIND=0.0.0.0:7700
Environment=TASKD_API_URL=http://127.0.0.1:7710
Environment=TASKD_API_TOKEN_FILE=%h/taskd/api.token
Environment=TASKD_GUI_ALLOWED_HOSTS=192.168.1.103,home-dev
Environment=TASKD_GUI_SESSION_SECRET_FILE=%h/taskd/gui.session-secret
Environment=TASKD_GUI_PASSWORD_FILE=%h/taskd/gui.password
Environment=TASKD_GUI_RELEASE=%i
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
