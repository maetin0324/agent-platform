# fixture org（Phase G13f-1 の e2e、gui/e2e/g13.spec.ts）: 組織（`org_include`）と `[[genres]]` を持つ設定。
# `config/org.example.toml` を .run/<name>/org.toml に写して読ませる（課の genre がここの [[genres]] と噛み合う）。
# 相対パスは設定ファイルのあるディレクトリ（.run/<name>/）基準。@RUN_DIR@ / @API_LISTEN@ は celeris.sh が置換する。
db = "celeris.sqlite3"
workspace_root = "workspaces"
tick_ms = 200
max_concurrency = 2
lease_grace_secs = 60
idle_timeout_secs = 30
kill_grace_secs = 1
review_timeout_secs = 30
error_cooldown_secs = 300
retry_backoff_base_secs = 0
retry_backoff_max_secs = 0
max_requeues = 5

# 組織の種（DB の org_nodes が空のときだけ読まれる）。
org_include = "org.toml"

# 担当ごとの長期記憶（SPEC §3.2「記憶は案件をまたぐ」）。
[memory]
dir = "memory"

[plan]
auto_accept = false

[reviewer]
tier = "standard"

[reports]
compress_after = 4
compress_after_secs = 7200

[api]
listen = "@API_LISTEN@"
token_file = "api.token"

[adapters.fake]
command = ["sh", "@RUN_DIR@/fake-worker.sh"]

[[providers]]
id = "fake-local"
adapter = "fake"
tiers = ["frontier", "standard", "cheap"]
concurrency = 2
model = "fake"

# 役割（`config/celeris.example.toml` と同じ。adapter は書かず tier だけ = fake のままで回る）。
[[roles]]
id = "lead"
tier = "frontier"
instructions = "あなたは取りまとめ役。実装は delegate で部下に任せ、自分は分割とレビューに集中する。"

[[roles]]
id = "implementer"
tier = "standard"
instructions = "あなたは実装担当。受け取った範囲だけを実装し、終わったら summary を書く。"

[[roles]]
id = "secretary"
tier = "standard"
instructions = "あなたは人の秘書。案件を受け取り、組織に流し、報告を集めて人に渡す。"

[[roles]]
id = "literature-scout"
tier = "cheap"
instructions = "あなたは調査担当。広く候補論文を探す。"

[[roles]]
id = "literature-reader"
tier = "standard"
instructions = "あなたは精読担当。候補論文を読み込み、引用付きで要点をまとめる。"

# 分野（`config/org.example.toml` の課が使う 3 つ）。
[[genres]]
id = "secretary"
description = "人と話し、案件を理解し、組織に流す"
default_role = "secretary"
roles = ["secretary"]

[[genres]]
id = "coding"
description = "コードを書く・直す・テストする"
default_role = "implementer"
roles = ["lead", "implementer"]

[[genres]]
id = "literature"
description = "関連研究の調査・先行研究の確認・新規性の検討"
default_role = "literature-reader"
roles = ["literature-scout", "literature-reader"]

# celeris 側（08267d9「研究文献調査課 / Web 調査課」の分割、Phase G13j で発覚）: `config/org.example.toml`
# の `research-web` が使う分野。実際の LDR ハーネスは持ち込まず、fixture では役割を借りるだけ（この課へ
# タスクを流す e2e は今のところ無いので、設定検証を通すためだけの最小定義）。
[[genres]]
id = "web-research"
description = "論文化されていない実装・製品・仕様を一般 Web 検索で調べる"
default_role = "literature-reader"
roles = ["literature-reader"]
