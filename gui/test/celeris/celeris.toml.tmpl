# scripts/celeris.sh start <name> が .run/<name>/config.toml として展開する（docs/DESIGN.md §10.0）。
# 相対パスは設定ファイルのあるディレクトリ（.run/<name>/）基準。@RUN_DIR@ / @API_LISTEN@ は celeris.sh が置換する。
db = "celeris.sqlite3"
workspace_root = "workspaces"
tick_ms = 200
max_concurrency = 2
lease_grace_secs = 60
idle_timeout_secs = 30
kill_grace_secs = 1
review_timeout_secs = 30
error_cooldown_secs = 300
retry_backoff_base_secs = 0
retry_backoff_max_secs = 0
max_requeues = 5

[plan]
auto_accept = false

[reviewer]
tier = "standard"

[api]
listen = "@API_LISTEN@"

[adapters.fake]
command = ["sh", "@RUN_DIR@/fake-worker.sh"]

[[providers]]
id = "fake-local"
adapter = "fake"
tiers = ["frontier", "standard", "cheap"]
concurrency = 2
model = "fake"
