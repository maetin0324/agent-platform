{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "example-openai-compat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Example OpenAI-compatible endpoint (vLLM / llama.cpp, tunneled)",
      "options": { "baseURL": "http://127.0.0.1:18000/v1", "apiKey": "unused" },
      "models": { "example-model": { "name": "Example Model" } }
    }
  },
  "model": "example-openai-compat/example-model",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny",
    "task": "deny"
  }
}
