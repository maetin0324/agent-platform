#!/bin/sh
# ADR-0056 Phase 101 追記: Remote Desktop Commander（RDC）経由の ChatGPT 向けの、たった 1 本の入口。
#
# 構成: ChatGPT → RDC device agent（専用 Linux ユーザー chatgpt-rdc、権限最小）→ この celeris-chat
# → 127.0.0.1:18200/mcp（token）→ Celeris MCP。専用ユーザーのシェルからはこのスクリプトだけを
# 呼ばせ、汎用 curl で HTTP API を直接叩かせない（MCP client の scope で許される操作だけに絞るため。
# `docs/mcp.md` §8 参照）。中身は `celerisctl mcp call` をそのまま呼ぶだけの薄いラッパ（判断も検証も
# 持たない）。
#
# 使い方: celeris-chat <TOOL> [JSON_ARGS]
#         celeris-chat --list
#
# 運用（`scripts/rdc/setup-chatgpt-rdc.sh` が整える）: 専用ユーザー（chatgpt-rdc）は rmaeda のホーム下の
# `~/.local/celeris/current/bin/celerisctl` を読めないので、setup スクリプトが現行リリースの `celerisctl` を
# このスクリプトと同じディレクトリ（`~chatgpt-rdc/.local/bin/`）にコピーする。`CELERIS_BIN` が無いときの
# 探し順: (1) このスクリプトと同じディレクトリの `celerisctl`、(2) `$HOME/.local/bin/celerisctl`、
# (3) `$HOME/.local/celeris/current/bin/celerisctl`（rmaeda 自身が使うとき）、(4) PATH 上の `celerisctl`。
# token ファイル（`CELERIS_MCP_TOKEN_FILE` の既定 `$HOME/.config/celeris/mcp-token`）は専用ユーザーだけが
# 読める権限（0600）で置く（setup スクリプトが置く。値は表示しない）。

if [ -z "${CELERIS_BIN:-}" ]; then
  here=$(cd "$(dirname "$0")" && pwd)
  for candidate in \
    "$here/celerisctl" \
    "$HOME/.local/bin/celerisctl" \
    "$HOME/.local/celeris/current/bin/celerisctl"; do
    if [ -x "$candidate" ]; then
      CELERIS_BIN=$candidate
      break
    fi
  done
  : "${CELERIS_BIN:=celerisctl}"
fi

exec "$CELERIS_BIN" mcp call \
  --base-url "${CELERIS_MCP_URL:-http://127.0.0.1:18200}" \
  --token-file "${CELERIS_MCP_TOKEN_FILE:-$HOME/.config/celeris/mcp-token}" \
  "$@"
