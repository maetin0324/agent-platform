{
  "$defs": {
    "ArtifactRef": {
      "description": "DESIGN §4.4 の `ArtifactRef`。実体は `workspace/<task_id>/artifacts/` 配下。",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "sha256",
        "kind"
      ],
      "type": "object"
    },
    "Budget": {
      "description": "DESIGN §4.1 の `Budget`。",
      "properties": {
        "max_retries": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_wall_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_turns",
        "max_wall_secs",
        "max_retries"
      ],
      "type": "object"
    },
    "Check": {
      "description": "DESIGN §5.3/§5.7 の `Check` 種別。",
      "oneOf": [
        {
          "properties": {
            "cmd": {
              "type": "string"
            },
            "expect_exit": {
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cmd",
            "expect_exit"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "artifact_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "reviewer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "human",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Criterion": {
      "description": "DESIGN §4.1 の `Criterion`。",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "check"
      ],
      "type": "object"
    },
    "Event": {
      "description": "DESIGN §4.3 の `Event`（追記専用）。ADR-0002 D2: `Transitioned` は遷移の\n*結果* を記録するものであり、`transition()` の入力（`Trigger`）とは別物。\n`JsonSchema` は ADR-0013 D8: `docs/api/v1/event.schema.json`（`EventRow` 経由）の契約に使う。",
      "oneOf": [
        {
          "properties": {
            "task": {
              "$ref": "#/$defs/Task"
            },
            "type": {
              "const": "created",
              "type": "string"
            }
          },
          "required": [
            "type",
            "task"
          ],
          "type": "object"
        },
        {
          "properties": {
            "from": {
              "$ref": "#/$defs/Status"
            },
            "reason": {
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/Status"
            },
            "type": {
              "const": "transitioned",
              "type": "string"
            }
          },
          "required": [
            "type",
            "from",
            "to",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "account": {
              "description": "プール（`account_pool = true`）で選ばれた Claude アカウントの id（ADR-0024 D4）。プールを使わない\nプロバイダ・導入前のイベントには無い。`provider`（アダプタ×プロバイダ行）とは別軸。",
              "type": [
                "string",
                "null"
              ]
            },
            "adapter": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "description": "どのプロバイダ（= アカウント）で実行したか（ADR-0012 D1）。導入前のイベントには無いので任意。",
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunRole"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ADR-0014 D1: `None` はワーカー run、`Some(Reviewer)` は Reviewer run（ワーカー run に `Some(Worker)` は書かない）。"
            },
            "run_id": {
              "type": "string"
            },
            "task_role": {
              "description": "ADR-0016 D1: run 開始時のタスクの役割名（`Task.role`）。役割の無いタスク・導入前のイベントには無い。",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "worker_started",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "adapter",
            "model"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0048 D2（Phase 60a）: 構造化した進行。`msg` は従来どおり人が読む 1 行で、\n`kind` / `tool` / `summary` / `detail` / `truncated` / `error` は**追加のみ**\n（付けないワーカー・導入前のイベントは全て `None` / `false` として読める）。\n構築は `Event::worker_progress` / `Event::worker_progress_with` を使う。",
          "properties": {
            "detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": "boolean"
            },
            "kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProgressKind"
                },
                {
                  "type": "null"
                }
              ]
            },
            "msg": {
              "type": "string"
            },
            "run_id": {
              "type": "string"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "tool": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            },
            "type": {
              "const": "worker_progress",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "msg"
          ],
          "type": "object"
        },
        {
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "run_id": {
              "type": "string"
            },
            "type": {
              "const": "artifact_produced",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "artifact"
          ],
          "type": "object"
        },
        {
          "properties": {
            "outcome": {
              "type": "string"
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunRole"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ADR-0014 D1: `WorkerStarted.role` と同じ（`None` はワーカー run）。"
            },
            "run_id": {
              "type": "string"
            },
            "type": {
              "const": "worker_finished",
              "type": "string"
            },
            "usage": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Usage"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "run_id",
            "outcome"
          ],
          "type": "object"
        },
        {
          "properties": {
            "criterion_idx": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "pass": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "run_id": {
              "type": "string"
            },
            "type": {
              "const": "review_verdict",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "criterion_idx",
            "pass",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "approval_requested",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "by": {
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "approval_decided",
              "type": "string"
            }
          },
          "required": [
            "type",
            "by",
            "approved"
          ],
          "type": "object"
        },
        {
          "description": "`blocked` のタスクへの人間の回答（ADR-0010 D3, P-10）。`Transitioned{reason:\"answer\"}` と同一トランザクションで\n追記し、次の run の `context.answers` に載せる。",
          "properties": {
            "answer": {
              "type": "string"
            },
            "question": {
              "type": "string"
            },
            "type": {
              "const": "answered",
              "type": "string"
            }
          },
          "required": [
            "type",
            "question",
            "answer"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0021 D2: ディスパッチャが人間に出した質問（run の終了ではないので `WorkerFinished` は使わない）。\n状態は変えない（`replay` は無視する）。同じトランザクションの `Transitioned{to: blocked}` と対で記録する。",
          "properties": {
            "run_id": {
              "description": "この質問のきっかけになった run（親の直近の run）。",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "question_raised",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0016 D2: 実行中の run が `delegate` で提案し、検証を通って挿入された子タスク。状態は変えない（`replay` は無視する）。",
          "properties": {
            "run_id": {
              "type": "string"
            },
            "task_ids": {
              "items": {
                "$ref": "#/$defs/TaskId"
              },
              "type": "array"
            },
            "type": {
              "const": "delegated",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "task_ids"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0018 D2: クラスタへの ssh 多重接続が無く、そのクラスタでは実行できない（人のログイン待ち）。",
          "properties": {
            "cluster": {
              "type": "string"
            },
            "host": {
              "default": "",
              "description": "`~/.ssh/config` の `Host` 名（`scripts/cluster-login.sh <host>` を案内するため）。第 1 段階の行には無いので任意。",
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "type": {
              "const": "cluster_unavailable",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cluster",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "provider": {
              "type": "string"
            },
            "reason": {
              "description": "供給側失敗の種別（ADR-0013 D9）: `throttled | auth_failed | exhausted | spawn`。\n導入前のイベントには無いので任意。このバリアントを構築している箇所は現状無い\n（`grep -rn ProviderThrottled crates` で確認済み）。",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "provider_throttled",
              "type": "string"
            },
            "until": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "provider",
            "until"
          ],
          "type": "object"
        },
        {
          "description": "Phase 31（実機の事故、2026-09-18）: `failed`/`cancelled` を複製してやり直したときの新しいタスクに\n記録する。`from` = 元のタスク。状態は変えない（`Created` が初期状態を与える）。",
          "properties": {
            "from": {
              "$ref": "#/$defs/TaskId"
            },
            "type": {
              "const": "retried",
              "type": "string"
            }
          },
          "required": [
            "type",
            "from"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0044 D1（Phase 53）: 人がタスクを編集した（`PATCH /tasks/{id}`）。`fields` は変えた項目の名前\n（`title` / `priority` / `labels` …。並びは決定的）、`by` は `\"human\"`。状態は変えない\n（`replay` は無視する）。",
          "properties": {
            "by": {
              "type": "string"
            },
            "fields": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "edited",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fields",
            "by"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0046 D5（Phase 59）: `assignee` が無いタスクの担当を matching が決めた。状態は変えない\n（`replay` は無視する）。GUI のタスク画面が「なぜこの担当か」をこの 1 件から出す。",
          "properties": {
            "node": {
              "description": "決まった担当（`org_nodes.id`）。",
              "type": "string"
            },
            "reason": {
              "description": "決め手（決定的な文面。LLM は使わない）。",
              "type": "string"
            },
            "score": {
              "description": "タスクの skills とノードの実効 skills の重なりの数。",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "assigned",
              "type": "string"
            }
          },
          "required": [
            "type",
            "node",
            "score",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "Lease": {
      "description": "DESIGN §4.1 の `Lease`。ADR-0002 D7: `expires_at` は\n`budget.max_wall_secs + 猶予` から `acquire_lease` 呼び出し側が計算する。",
      "properties": {
        "expires_at": {
          "type": "string"
        },
        "worker_run_id": {
          "type": "string"
        }
      },
      "required": [
        "worker_run_id",
        "expires_at"
      ],
      "type": "object"
    },
    "MessageId": {
      "description": "対話の 1 行の識別子（ULID）。",
      "type": "string"
    },
    "MilestoneId": {
      "description": "途中目標の一意識別子（ULID）。",
      "type": "string"
    },
    "ProgressKind": {
      "description": "ADR-0048 D2（Phase 60a）: ワーカーの進行の種別。アダプタごとの差はアダプタ側で吸収し、\nConsole（ADR-0048 D1）はこの 5 種だけを知る。`comment` はプロトコルの別 type（ADR-0044 D2）の\nままなのでここには無い。",
      "oneOf": [
        {
          "const": "tool_use",
          "description": "道具を使った（`tool` に名前、`summary` に入力の 1 行要約）。",
          "type": "string"
        },
        {
          "const": "tool_result",
          "description": "道具の結果（`summary` に先頭の要約、`error` に失敗の印）。",
          "type": "string"
        },
        {
          "const": "text",
          "description": "モデルの発話。",
          "type": "string"
        },
        {
          "const": "thinking",
          "description": "思考（要約だけ。本文は流さない）。",
          "type": "string"
        },
        {
          "const": "status",
          "description": "アダプタの節目（起動・段取り・終わりなど）。",
          "type": "string"
        }
      ]
    },
    "ProjectId": {
      "description": "案件の一意識別子（ULID）。`TaskId` と同じ形。",
      "type": "string"
    },
    "RepoId": {
      "description": "リポジトリの一意識別子（ULID）。`TaskId` / `ProjectId` と同じ形。",
      "type": "string"
    },
    "RepoRef": {
      "description": "タスクが使うリポジトリの参照（`tasks.repos_json` の 1 要素。ADR-0043 D2）。\n`name` も持つのは、リポジトリの行が消えた後でも前置きと GUI が名前を出せるようにするため。",
      "properties": {
        "name": {
          "type": "string"
        },
        "repo_id": {
          "$ref": "#/$defs/RepoId"
        }
      },
      "required": [
        "repo_id",
        "name"
      ],
      "type": "object"
    },
    "RunRole": {
      "description": "run の役割（ADR-0014 D1）。`Event::WorkerStarted` / `WorkerFinished` の `role`。",
      "enum": [
        "worker",
        "reviewer"
      ],
      "type": "string"
    },
    "Status": {
      "description": "ADR-0002 D1 の状態集合。終端は `done | failed | cancelled`。",
      "enum": [
        "draft",
        "ready",
        "running",
        "blocked",
        "reviewing",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "Task": {
      "description": "DESIGN §4.1 の `Task`。",
      "properties": {
        "acceptance": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "aggregate": {
          "description": "ADR-0016 D3: true なら、委譲した子が全て終端になった後に集約 run を 1 回だけ行い `artifacts/summary.md` を作らせる。",
          "type": "boolean"
        },
        "assignee": {
          "description": "ADR-0033 D2: 割り当てられた組織のノード（`org_nodes.id`）。あれば `worker_hint` の解決で\n役割・分野より先に見る。無ければ従来どおり（互換）。",
          "type": [
            "string",
            "null"
          ]
        },
        "attempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "category": {
          "$ref": "#/$defs/TaskCategory",
          "description": "ADR-0044 D3: 種類（既定 `other`）。導入前のタスクには無いので既定で埋まる。"
        },
        "conversation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MessageId"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0033 D4（Phase 24）: 対話由来のタスクなら、きっかけになった人の発言（`messages.id`）。\nrun が終わると、その結果が `assignee` のノードの返事として `messages` に入る。\n**DB の列は増やさない**（`json` 列の中だけ。導入前のタスクには無いので任意）。"
        },
        "created_at": {
          "type": "string"
        },
        "depends_on": {
          "items": {
            "$ref": "#/$defs/TaskId"
          },
          "type": "array"
        },
        "genre": {
          "description": "ADR-0027 D1: 分野名（自由記述。`[[genres]] id` と一致すれば既定の役割・プロンプトの説明が効く）。\n状態機械は見ない。導入前のタスクには無いので任意。",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/TaskId"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/TaskKind"
        },
        "labels": {
          "description": "ADR-0044 D3: 自由なラベル（小文字・`[a-z0-9-]`・最大 8 個）。導入前のタスクには無いので既定は空。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lease": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lease"
            },
            {
              "type": "null"
            }
          ]
        },
        "milestone_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/MilestoneId"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0033 D2: このタスクが属する途中目標（`project_id` の案件のもの）。"
        },
        "mode": {
          "$ref": "#/$defs/TaskMode",
          "description": "ADR-0046 D4: 進め方（`prototype` / `production` / `research`。既定 `production`）。"
        },
        "objective": {
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "format": "int32",
          "type": "integer"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectId"
            },
            {
              "type": "null"
            }
          ],
