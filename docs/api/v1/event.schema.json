{
  "$defs": {
    "ArtifactRef": {
      "description": "DESIGN §4.4 の `ArtifactRef`。実体は `workspace/<task_id>/artifacts/` 配下。",
      "properties": {
        "declared": {
          "default": true,
          "description": "ADR-0067 D3: `result.json`/プロトコルの `{\"type\":\"artifact\"}` で申告されたものは `true`。\ndispatcher が作業場所を走査して見つけた「未申告の成果物」は `false`。",
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "sha256",
        "kind"
      ],
      "type": "object"
    },
    "Budget": {
      "description": "DESIGN §4.1 の `Budget`。",
      "properties": {
        "max_retries": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_wall_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_turns",
        "max_wall_secs",
        "max_retries"
      ],
      "type": "object"
    },
    "Check": {
      "description": "DESIGN §5.3/§5.7 の `Check` 種別。",
      "oneOf": [
        {
          "properties": {
            "cmd": {
              "type": "string"
            },
            "expect_exit": {
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cmd",
            "expect_exit"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "artifact_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0067 D2: 知識ベースのページ参照（`task_core::knowledge::page_path` と同じ形。KB の根からの\n相対、`.md`、`..` 不可。実在の検証は組み立て時には行わない — `Check::ArtifactExists` と同様、\n人が確認するときに知識ベース側で気付く）。",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "knowledge_page",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "reviewer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "human",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Criterion": {
      "description": "DESIGN §4.1 の `Criterion`。",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "check"
      ],
      "type": "object"
    },
    "Event": {
      "description": "DESIGN §4.3 の `Event`（追記専用）。ADR-0002 D2: `Transitioned` は遷移の\n*結果* を記録するものであり、`transition()` の入力（`Trigger`）とは別物。\n`JsonSchema` は ADR-0013 D8: `docs/api/v1/event.schema.json`（`EventRow` 経由）の契約に使う。",
      "oneOf": [
        {
          "properties": {
            "task": {
              "$ref": "#/$defs/Task"
            },
            "type": {
              "const": "created",
              "type": "string"
            }
          },
          "required": [
            "type",
            "task"
          ],
          "type": "object"
        },
        {
          "properties": {
            "from": {
              "$ref": "#/$defs/Status"
            },
            "reason": {
              "type": "string"
            },
            "to": {
              "$ref": "#/$defs/Status"
            },
            "type": {
              "const": "transitioned",
              "type": "string"
            }
          },
          "required": [
            "type",
            "from",
            "to",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "account": {
              "description": "プール（`account_pool = true`）で選ばれた Claude アカウントの id（ADR-0024 D4）。プールを使わない\nプロバイダ・導入前のイベントには無い。`provider`（アダプタ×プロバイダ行）とは別軸。",
              "type": [
                "string",
                "null"
              ]
            },
            "adapter": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "provider": {
              "description": "どのプロバイダ（= アカウント）で実行したか（ADR-0012 D1）。導入前のイベントには無いので任意。",
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunRole"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ADR-0014 D1: `None` はワーカー run、`Some(Reviewer)` は Reviewer run（ワーカー run に `Some(Worker)` は書かない）。"
            },
            "run_id": {
              "type": "string"
            },
            "task_role": {
              "description": "ADR-0016 D1: run 開始時のタスクの役割名（`Task.role`）。役割の無いタスク・導入前のイベントには無い。",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "worker_started",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "adapter",
            "model"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0048 D2（Phase 60a）: 構造化した進行。`msg` は従来どおり人が読む 1 行で、\n`kind` / `tool` / `summary` / `detail` / `truncated` / `error` は**追加のみ**\n（付けないワーカー・導入前のイベントは全て `None` / `false` として読める）。\n構築は `Event::worker_progress` / `Event::worker_progress_with` を使う。",
          "properties": {
            "detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": "boolean"
            },
            "kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProgressKind"
                },
                {
                  "type": "null"
                }
              ]
            },
            "msg": {
              "type": "string"
            },
            "run_id": {
              "type": "string"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "tool": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            },
            "type": {
              "const": "worker_progress",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "msg"
          ],
          "type": "object"
        },
        {
          "properties": {
            "artifact": {
              "$ref": "#/$defs/ArtifactRef"
            },
            "run_id": {
              "type": "string"
            },
            "type": {
              "const": "artifact_produced",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "artifact"
          ],
          "type": "object"
        },
        {
          "properties": {
            "metrics": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunMetrics"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ADR-0061（Phase 104）: harness routing 基盤のメトリクス（wall time・retry 回数）。\n`WorkerStarted.adapter`/`model` と同じ `run_id` で突き合わせる。導入前のイベント・\nこの run の起点時刻を持たない経路（無い）は `None`。"
            },
            "outcome": {
              "type": "string"
            },
            "role": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunRole"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ADR-0014 D1: `WorkerStarted.role` と同じ（`None` はワーカー run）。"
            },
            "run_id": {
              "type": "string"
            },
            "type": {
              "const": "worker_finished",
              "type": "string"
            },
            "usage": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Usage"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "run_id",
            "outcome"
          ],
          "type": "object"
        },
        {
          "properties": {
            "criterion_idx": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "pass": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "run_id": {
              "type": "string"
            },
            "type": {
              "const": "review_verdict",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "criterion_idx",
            "pass",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "approval_requested",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "by": {
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "approval_decided",
              "type": "string"
            }
          },
          "required": [
            "type",
            "by",
            "approved"
          ],
          "type": "object"
        },
        {
          "description": "`blocked` のタスクへの人間の回答（ADR-0010 D3, P-10）。`Transitioned{reason:\"answer\"}` と同一トランザクションで\n追記し、次の run の `context.answers` に載せる。",
          "properties": {
            "answer": {
              "type": "string"
            },
            "question": {
              "type": "string"
            },
            "type": {
              "const": "answered",
              "type": "string"
            }
          },
          "required": [
            "type",
            "question",
            "answer"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0021 D2: ディスパッチャが人間に出した質問（run の終了ではないので `WorkerFinished` は使わない）。\n状態は変えない（`replay` は無視する）。同じトランザクションの `Transitioned{to: blocked}` と対で記録する。",
          "properties": {
            "run_id": {
              "description": "この質問のきっかけになった run（親の直近の run）。",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "question_raised",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0016 D2: 実行中の run が `delegate` で提案し、検証を通って挿入された子タスク。状態は変えない（`replay` は無視する）。",
          "properties": {
            "run_id": {
              "type": "string"
            },
            "task_ids": {
              "items": {
                "$ref": "#/$defs/TaskId"
              },
              "type": "array"
            },
            "type": {
              "const": "delegated",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "task_ids"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0018 D2: クラスタへの ssh 多重接続が無く、そのクラスタでは実行できない（人のログイン待ち）。",
          "properties": {
            "cluster": {
              "type": "string"
            },
            "host": {
              "default": "",
              "description": "`~/.ssh/config` の `Host` 名（`scripts/cluster-login.sh <host>` を案内するため）。第 1 段階の行には無いので任意。",
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "type": {
              "const": "cluster_unavailable",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cluster",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0062 A（Phase 107）: celeris が保持していた ssh master（`ClusterMaster`）のプロセスが、\n明示的な切断（`DELETE /clusters/{id}/connect`）を経ずに自分で終了した。`exit_code` は分かる\nときだけ（シグナルで落ちた場合は `None`）、`stderr_tail` は master の stderr の末尾（最大 300\nバイト。ADR-0032 D4 のとおり検証コードはここには出ない）。同じ切断について 1 回だけ記録する\n（`Dispatcher` 側で dedupe する。`mark_cluster_unavailable` から呼ぶ）。",
          "properties": {
            "cluster": {
              "type": "string"
            },
            "exit_code": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "stderr_tail": {
              "default": "",
              "type": "string"
            },
            "type": {
              "const": "cluster_master_exited",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cluster"
          ],
          "type": "object"
        },
        {
          "properties": {
            "provider": {
              "type": "string"
            },
            "reason": {
              "description": "供給側失敗の種別（ADR-0013 D9）: `throttled | auth_failed | exhausted | spawn`。\n導入前のイベントには無いので任意。このバリアントを構築している箇所は現状無い\n（`grep -rn ProviderThrottled crates` で確認済み）。",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "provider_throttled",
              "type": "string"
            },
            "until": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "provider",
            "until"
          ],
          "type": "object"
        },
        {
          "description": "Phase 31（実機の事故、2026-09-18）: `failed`/`cancelled` を複製してやり直したときの新しいタスクに\n記録する。`from` = 元のタスク。状態は変えない（`Created` が初期状態を与える）。",
          "properties": {
            "from": {
              "$ref": "#/$defs/TaskId"
            },
            "type": {
              "const": "retried",
              "type": "string"
            }
          },
          "required": [
            "type",
            "from"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0044 D1（Phase 53）: 人がタスクを編集した（`PATCH /tasks/{id}`）。`fields` は変えた項目の名前\n（`title` / `priority` / `labels` …。並びは決定的）、`by` は `\"human\"`。状態は変えない\n（`replay` は無視する）。",
          "properties": {
            "by": {
              "type": "string"
            },
            "fields": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "edited",
              "type": "string"
            }
          },
          "required": [
            "type",
            "fields",
            "by"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0046 D5（Phase 59）: `assignee` が無いタスクの担当を matching が決めた。状態は変えない\n（`replay` は無視する）。GUI のタスク画面が「なぜこの担当か」をこの 1 件から出す。",
          "properties": {
            "node": {
              "description": "決まった担当（`org_nodes.id`）。",
              "type": "string"
            },
            "reason": {
              "description": "決め手（決定的な文面。LLM は使わない）。",
              "type": "string"
            },
            "score": {
              "description": "タスクの skills とノードの実効 skills の重なりの数。",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "assigned",
              "type": "string"
            }
          },
          "required": [
            "type",
            "node",
            "score",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0059 D3（Phase 99）: `mode` 省略のリモートタスクが worktree 準備で「git リポジトリでない」\n（exit 65）になり、`repos` が無い（コードを触らない仕事）ので `shared` として続行した。\n状態は変えない（`replay` は無視する）。この後 `task.workspace.mode` が `Some(Shared)` に\n書き戻る（`Event::Edited` は積まない。編集は人によるものではないため）。",
          "properties": {
            "cluster": {
              "type": "string"
            },
            "path": {
              "description": "クラスタ側の作業ディレクトリ（展開前の `path` の文字列表現）。",
              "type": "string"
            },
            "reason": {
              "description": "worktree 準備が失敗した理由（ssh.rs の stderr）。",
              "type": "string"
            },
            "type": {
              "const": "workspace_mode_downgraded",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cluster",
            "path",
            "reason"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0066 D2（Phase 110b）: 終端になってから `[workspace] prune_after_secs` 経った作業場所から、\nビルド生成物（`target/` 等）を消した。状態は変えない（`replay` は無視する）。",
          "properties": {
            "removed": {
              "description": "消したパス（作業場所〈`<workspace_root>/<task_id>`〉からの相対。例: `repos/benchfs/target`）。",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "workspace_pruned",
              "type": "string"
            }
          },
          "required": [
            "type",
            "removed"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0069 D5（Phase 114）: この run の routing の監査記録（担当・harness・lane・model・features・\n当たった規則・policy の版・エスカレーション）。同じ `run_id` の `WorkerStarted` の直後に 1 件。\n状態は変えない（`replay` は無視する）。",
          "properties": {
            "record": {
              "$ref": "#/$defs/RoutingRecord"
            },
            "run_id": {
              "type": "string"
            },
            "type": {
              "const": "routing_decided",
              "type": "string"
            }
          },
          "required": [
            "type",
            "run_id",
            "record"
          ],
          "type": "object"
        }
      ]
    },
    "LaneDecision": {
      "description": "ADR-0069 D3: lane の決定（監査記録の本体）。",
      "properties": {
        "clamped_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "escalation": {
          "description": "リトライでのエスカレーションの判断（`retry_policy`）。",
          "type": [
            "string",
            "null"
          ]
        },
        "features": {
          "$ref": "#/$defs/TaskFeatures"
        },
        "hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tier"
            },
            {
              "type": "null"
            }
          ],
          "description": "LLM が書いた tier（`TierSource::Hint`。記録するだけ）。"
        },
        "lane": {
          "$ref": "#/$defs/Tier",
          "description": "最終的な lane（天井・エスカレーションの後。残量による調整の前）。"
        },
        "policy_version": {
          "type": "string"
        },
        "proposed": {
          "$ref": "#/$defs/Tier",
          "description": "規則表が出した lane（天井・エスカレーションの前）。"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule_id": {
          "type": "string"
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShadowDecision"
            },
            {
              "type": "null"
            }
          ],
          "description": "Phase 2 の予約（shadow 分類器）。Phase 1 では常に `None`。"
        },
        "source": {
          "$ref": "#/$defs/TierSource"
        }
      },
      "required": [
        "lane",
        "proposed",
        "source",
        "rule_id",
        "policy_version",
        "features"
      ],
      "type": "object"
    },
    "LaneResolution": {
      "description": "ADR-0069 D4: lane → provider / account / model / reasoning effort の解決結果（監査記録）。\n解決そのものは従来の `select_provider` → `TieredAdapter::model_for_tier` → `select_tier` のまま。",
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter": {
          "type": "string"
        },
