{
  "$defs": {
    "Answer": {
      "description": "以前の `question` への人間の回答（`context.answers[]`。ADR-0010 D3, P-10）。",
      "properties": {
        "answer": {
          "type": "string"
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "type": "object"
    },
    "ArtifactRef": {
      "description": "DESIGN §4.4 の `ArtifactRef`。実体は `workspace/<task_id>/artifacts/` 配下。",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "sha256",
        "kind"
      ],
      "type": "object"
    },
    "Budget": {
      "description": "DESIGN §4.1 の `Budget`。",
      "properties": {
        "max_retries": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_wall_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_turns",
        "max_wall_secs",
        "max_retries"
      ],
      "type": "object"
    },
    "Check": {
      "description": "DESIGN §5.3/§5.7 の `Check` 種別。",
      "oneOf": [
        {
          "properties": {
            "cmd": {
              "type": "string"
            },
            "expect_exit": {
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cmd",
            "expect_exit"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "artifact_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "reviewer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "human",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ChildSummary": {
      "description": "`context.children[]`（ADR-0016 D3 / M4）: 集約 run に渡す、委譲した子の要約。",
      "properties": {
        "artifacts": {
          "description": "子のワークスペースに残った成果物（`ArtifactProduced` の一覧。パスは子のワークスペース相対）。",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/TaskId"
        },
        "outcome": {
          "description": "直近のワーカー run の `WorkerFinished.outcome`（無ければ省略）。",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "title": {
          "type": "string"
        },
        "workspace": {
          "description": "子のワークスペース（絶対パス。集約 run が成果物を読むため）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "status"
      ],
      "type": "object"
    },
    "ConversationAddressee": {
      "description": "`context.conversation_addressee`（ADR-0033 D4 / Phase 28）: この run が対話用タスクなら、相手が\n秘書かそれ以外かを表す。対話でない run では `None`。この値そのものは判断せず、`preamble::render`\nが対話専用の指示文（作業を始めない・委譲不可）を出し分けるためだけに使う純粋なデータ\n（判定はディスパッチャが `task.conversation` と組織図から決定的に行う。DESIGN 原則 1）。",
      "enum": [
        "secretary",
        "other"
      ],
      "type": "string"
    },
    "ConversationTurn": {
      "description": "`context.conversation[]`（ADR-0033 D4 / Phase 24）: この案件でのこのノードと人の直近のやり取り。",
      "properties": {
        "role": {
          "$ref": "#/$defs/MessageRole"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "type": "object"
    },
    "Criterion": {
      "description": "DESIGN §4.1 の `Criterion`。",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "check"
      ],
      "type": "object"
    },
    "DelegateDep": {
      "anyOf": [
        {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "`delegate.tasks[].depends_on[]` の 1 要素（ADR-0016 M7）: 同じ配列内のインデックス（整数）か、既存タスクの ID（文字列）。"
    },
    "DelegateTask": {
      "additionalProperties": false,
      "description": "ワーカーが提案する子タスク 1 件。未知フィールドは拒否する（Plan の `NewTask` と同じ方針）。",
      "properties": {
        "acceptance": {
          "description": "1 件以上。",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "assignee": {
          "description": "ADR-0033 D4（Phase 24）: 割り当てる組織のノード（`org_nodes.id`）。「誰の仕事か」を表す。\n`role` を書かなかったときだけ、そのノードの分野が既定（tier / adapter / 予算）の解決に使われる\n（タスクの値 > 役割の既定 > 分野の既定 > 親の値。ADR-0016 D1 の優先順に合わせる）。",
          "type": [
            "string",
            "null"
          ]
        },
        "depends_on": {
          "items": {
            "$ref": "#/$defs/DelegateDep"
          },
          "type": "array"
        },
        "genre": {
          "description": "ADR-0027 D1: 分野名（任意）。未指定なら `role` の分野（一意なら）→ 親の分野の順で継ぐ。\n`role` と両方指定したときは `role` がその分野の `roles` に含まれること（含まれなければ設定エラー）。",
          "type": [
            "string",
            "null"
          ]
        },
        "objective": {
          "type": "string"
        },
        "role": {
          "description": "役割名（任意。`[[roles]]` にあれば既定と指示文が効く）。",
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tier"
            },
            {
              "type": "null"
            }
          ],
          "description": "省略時は役割の既定 → 親の tier。"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "objective",
        "acceptance"
      ],
      "type": "object"
    },
    "Evidence": {
      "description": "`done.evidence[]`。`command` / `exit` / `stdout_tail` は、コマンドを伴わない条件（`ArtifactExists` / `Reviewer` / `Human`）では\n存在しないので任意（ADR-0012 D3, P-12。必須 → 任意の緩和なので後方互換）。",
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "criterion": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "exit": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout_tail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "criterion"
      ],
      "type": "object"
    },
    "GenreContext": {
      "description": "`context.available_genres[]`（ADR-0027 D1）: 委譲できる run に渡す、使える分野と役割の一覧。\n「タスクの分野」ではなく「この run が子に割り当てられる分野の選択肢」を表す。",
      "properties": {
        "capabilities": {
          "description": "ADR-0028 D1/D2: この分野で「できること」の自由記述。空なら省略される。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "harness": {
          "description": "Phase 38（ADR-0028 追記）: この分野の担当が動くハーネスのアダプタ id\n（`default_role` の役割の `adapter`。`GenreSpec::harness_adapter`）。`paperqa` /\n`local-deep-research` のとき、成果物の名前は**固定**で担当は別のファイルを書けない\n（`is_harness`）。決定的に決まる値で、プロンプトに「成果物の規約」を出すかの判断にだけ使う。",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "input_artifacts": {
          "description": "ADR-0028 D1/D2: この分野に渡すもの（目安、自由記述）。空なら省略される。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "output_artifacts": {
          "description": "ADR-0028 D1/D2: この分野から返るもの（目安、自由記述）。空なら省略される。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/GenreRoleContext"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    },
    "GenreRoleContext": {
      "description": "`context.available_genres[].roles[]`（ADR-0027 D1）: 分野に属する役割の id。指示文までは渡さない\n（長くなりすぎるため。プロンプトに前置きされる指示文は `context.role` 側の役目）ので `description` は\n今のところ常に省略だが、将来役割に説明文を持たせたときのために型としては残す。",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Lease": {
      "description": "DESIGN §4.1 の `Lease`。ADR-0002 D7: `expires_at` は\n`budget.max_wall_secs + 猶予` から `acquire_lease` 呼び出し側が計算する。",
      "properties": {
        "expires_at": {
          "type": "string"
        },
        "worker_run_id": {
          "type": "string"
        }
      },
      "required": [
        "worker_run_id",
        "expires_at"
      ],
      "type": "object"
    },
    "MemoryContext": {
      "description": "`context.memory`（ADR-0033 D6 / Phase 24）: 案件をまたぐ記憶と、この案件の引き出し。\nどちらも `<memory_dir>/<node_id>/…` のファイルの中身（字数で切ったもの）。",
      "properties": {
        "notes": {
          "description": "`notes.md`（クラスタの使い方、人の好み、直近の相談）。",
          "type": "string"
        },
        "project": {
          "description": "`projects/<project_id>.md`（この案件だけの事）。",
          "type": "string"
        }
      },
      "type": "object"
    },
    "MessageId": {
      "description": "対話の 1 行の識別子（ULID）。",
      "type": "string"
    },
    "MessageRole": {
      "description": "誰が言ったか（ADR-0033 D4）。`user` = 人、`node` = 組織のノード（その run の返事）。",
      "enum": [
        "user",
        "node"
      ],
      "type": "string"
    },
    "MilestoneId": {
      "description": "途中目標の一意識別子（ULID）。",
      "type": "string"
    },
    "NodeContext": {
      "description": "`context.node`（ADR-0033 D4 / Phase 24）: この run をしている「人」（組織のノード）。\nプロンプトの一番前に「あなたは誰で、何の担当か」として置かれる。",
      "properties": {
        "brief": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "OrgKind": {
      "description": "組織のノードの種類（ADR-0033 D1）。`secretary` は根で 1 つだけ。",
      "enum": [
        "secretary",
        "department",
        "section"
      ],
      "type": "string"
    },
    "OrgNodeContext": {
      "description": "`context.organization[]`（ADR-0033 D4 / Phase 24）: 組織図。分解・委譲できる run に渡し、\n「どの課に何を振るか」を `assignee` で指定させる。",
      "properties": {
        "brief": {
          "type": "string"
        },
        "genre": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OrgKind",
          "description": "`secretary` / `department` / `section`。"
        },
        "name": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "PriorReview": {
      "description": "直前のレビュー結果（`context.prior_review[]`）。",
      "properties": {
        "criterion": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pass": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "pass",
        "reason"
      ],
      "type": "object"
    },
    "ProjectId": {
      "description": "案件の一意識別子（ULID）。`TaskId` と同じ形。",
      "type": "string"
    },
    "ProviderFailure": {
      "description": "`error.provider_failure`（任意）: 供給側の失敗の種別（ADR-0010 D5, P-21）。付いていればディスパッチャは\nattempts を消費せず `requeue` し、プロバイダを cooldown にする。",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "throttled",
              "type": "string"
            },
            "retry_after_secs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "retry_after_secs"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "auth_failed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "exhausted",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RecentWork": {
      "description": "`context.recent_work[]`（ADR-0033 D4 / Phase 33: 実機の事故 — 担当が自分の直近の仕事を知らずに\n「対象タスク ID が必要です」と聞き返した — の再発防止）。対話 run にだけ、その担当の直近の仕事を渡す。\n生成は決定的（ストアのタスクとイベントから組む。LLM は使わない。DESIGN 原則 1）。",
      "properties": {
        "artifacts": {
          "description": "この仕事が残した成果物の名前（パスは含まない）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "description": "終端の要約: `done` なら `summary` の 1 行目、`failed` なら理由、`blocked` なら質問。",
          "type": [
            "string",
            "null"
          ]
        },
        "project_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "title",
        "status"
      ],
      "type": "object"
    },
    "ReviewOutput": {
      "description": "`Review` run がワークスペース直下 `artifacts/review.json` に書く出力（ADR-0007 D1/D5）。",
      "properties": {
        "verdicts": {
          "items": {
            "$ref": "#/$defs/ReviewVerdictOut"
          },
          "type": "array"
        }
      },
      "required": [
        "verdicts"
      ],
      "type": "object"
    },
    "ReviewRequest": {
      "description": "`Reviewer` check のための `context.review`（ADR-0007 D5）。`RunRequest.task` は合成した `Review` kind の\nタスクで、対象タスクの `run` の `done` の内容と、判定すべき条件のインデックスを渡す。",
      "properties": {
        "criteria": {
          "description": "判定すべき `task.acceptance` のインデックス（`Check::Reviewer` の条件）。",
          "items": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "evidence": {
          "description": "対象 run の `done.evidence`。",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "summary": {
          "description": "対象 run の `done.summary`。",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "evidence",
        "criteria"
      ],
      "type": "object"
    },
    "ReviewVerdictOut": {
      "description": "`artifacts/review.json` の 1 判定（ADR-0007 D1/D5）。",
      "properties": {
        "criterion": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pass": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "pass",
        "reason"
      ],
      "type": "object"
    },
    "RoleContext": {
      "description": "`context.role`（ADR-0016 D1 / M3）: タスクの役割と `[[roles]]` の指示文。アダプタはプロンプトの前置きにする。",
      "properties": {
        "id": {
          "type": "string"
        },
        "instructions": {
          "description": "設定に指示文が無ければ空。",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "RunContext": {
      "description": "`run.context`。未知フィールドは無視する（前方互換）。",
      "properties": {
        "answers": {
          "description": "`taskctl answer` で与えられた回答の履歴（時系列）。無ければ省略（ADR-0010 D3）。",
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "type": "array"
        },
        "available_genres": {
          "description": "ADR-0027 D1: 委譲できる run（`build_execute_prompt` を使う run）にだけ、設定済みの分野と\nその役割の一覧を渡す。委譲できない run（`Plan`/`Review`）や `[[genres]]` が空の設定では空。",
          "items": {
            "$ref": "#/$defs/GenreContext"
          },
          "type": "array"
        },
        "children": {
          "description": "集約 run（`aggregate = true` の親の、子が全て終端になった後の run）でのみ非空（ADR-0016 D3）。",
          "items": {
            "$ref": "#/$defs/ChildSummary"
          },
          "type": "array"
        },
        "conversation": {
          "description": "ADR-0033 D4: 担当のノードとのこの案件での直近のやり取り（古い順）。",
          "items": {
            "$ref": "#/$defs/ConversationTurn"
          },
          "type": "array"
        },
        "conversation_addressee": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConversationAddressee"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0033 D4（Phase 28）: 対話用タスクの run にだけ `Some`。委譲・`Question` を使わせず、\n返事だけを求める前置き（`preamble::conversation_instructions`）を出すための印。"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryContext"
            },
            {
              "type": "null"
            }
          ],
