            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cluster": {
              "type": "string"
            },
            "kind": {
              "const": "remote",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cluster",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "run": {
      "description": "taskd → ワーカーの `run` メッセージ（1 行）。`{\"type\":\"run\", ...}`。",
