{
  "$defs": {
    "Answer": {
      "description": "以前の `question` への人間の回答（`context.answers[]`。ADR-0010 D3, P-10）。",
      "properties": {
        "answer": {
          "type": "string"
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "type": "object"
    },
    "ArtifactRef": {
      "description": "DESIGN §4.4 の `ArtifactRef`。実体は `workspace/<task_id>/artifacts/` 配下。",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "sha256",
        "kind"
      ],
      "type": "object"
    },
    "Budget": {
      "description": "DESIGN §4.1 の `Budget`。",
      "properties": {
        "max_retries": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_wall_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_turns",
        "max_wall_secs",
        "max_retries"
      ],
      "type": "object"
    },
    "Check": {
      "description": "DESIGN §5.3/§5.7 の `Check` 種別。",
      "oneOf": [
        {
          "properties": {
            "cmd": {
              "type": "string"
            },
            "expect_exit": {
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cmd",
            "expect_exit"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "artifact_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "reviewer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "human",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ChildSummary": {
      "description": "`context.children[]`（ADR-0016 D3 / M4）: 集約 run に渡す、委譲した子の要約。",
      "properties": {
        "artifacts": {
          "description": "子のワークスペースに残った成果物（`ArtifactProduced` の一覧。パスは子のワークスペース相対）。",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/TaskId"
        },
        "outcome": {
          "description": "直近のワーカー run の `WorkerFinished.outcome`（無ければ省略）。",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "title": {
          "type": "string"
        },
        "workspace": {
          "description": "子のワークスペース（絶対パス。集約 run が成果物を読むため）。",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "status"
      ],
      "type": "object"
    },
    "Criterion": {
      "description": "DESIGN §4.1 の `Criterion`。",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "check"
      ],
      "type": "object"
    },
    "DelegateDep": {
      "anyOf": [
        {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "`delegate.tasks[].depends_on[]` の 1 要素（ADR-0016 M7）: 同じ配列内のインデックス（整数）か、既存タスクの ID（文字列）。"
    },
    "DelegateTask": {
      "additionalProperties": false,
      "description": "ワーカーが提案する子タスク 1 件。未知フィールドは拒否する（Plan の `NewTask` と同じ方針）。",
      "properties": {
        "acceptance": {
          "description": "1 件以上。",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "depends_on": {
          "items": {
            "$ref": "#/$defs/DelegateDep"
          },
          "type": "array"
        },
        "genre": {
          "description": "ADR-0027 D1: 分野名（任意）。未指定なら `role` の分野（一意なら）→ 親の分野の順で継ぐ。\n`role` と両方指定したときは `role` がその分野の `roles` に含まれること（含まれなければ設定エラー）。",
          "type": [
            "string",
            "null"
          ]
        },
        "objective": {
          "type": "string"
        },
        "role": {
          "description": "役割名（任意。`[[roles]]` にあれば既定と指示文が効く）。",
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tier"
            },
            {
              "type": "null"
            }
          ],
          "description": "省略時は役割の既定 → 親の tier。"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "objective",
        "acceptance"
      ],
      "type": "object"
    },
    "Evidence": {
      "description": "`done.evidence[]`。`command` / `exit` / `stdout_tail` は、コマンドを伴わない条件（`ArtifactExists` / `Reviewer` / `Human`）では\n存在しないので任意（ADR-0012 D3, P-12。必須 → 任意の緩和なので後方互換）。",
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "criterion": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "exit": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout_tail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "criterion"
      ],
      "type": "object"
    },
    "GenreContext": {
      "description": "`context.available_genres[]`（ADR-0027 D1）: 委譲できる run に渡す、使える分野と役割の一覧。\n「タスクの分野」ではなく「この run が子に割り当てられる分野の選択肢」を表す。",
      "properties": {
        "capabilities": {
          "description": "ADR-0028 D1/D2: この分野で「できること」の自由記述。空なら省略される。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input_artifacts": {
          "description": "ADR-0028 D1/D2: この分野に渡すもの（目安、自由記述）。空なら省略される。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "output_artifacts": {
          "description": "ADR-0028 D1/D2: この分野から返るもの（目安、自由記述）。空なら省略される。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/GenreRoleContext"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    },
    "GenreRoleContext": {
      "description": "`context.available_genres[].roles[]`（ADR-0027 D1）: 分野に属する役割の id。指示文までは渡さない\n（長くなりすぎるため。プロンプトに前置きされる指示文は `context.role` 側の役目）ので `description` は\n今のところ常に省略だが、将来役割に説明文を持たせたときのために型としては残す。",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Lease": {
      "description": "DESIGN §4.1 の `Lease`。ADR-0002 D7: `expires_at` は\n`budget.max_wall_secs + 猶予` から `acquire_lease` 呼び出し側が計算する。",
      "properties": {
        "expires_at": {
          "type": "string"
        },
        "worker_run_id": {
          "type": "string"
        }
      },
      "required": [
        "worker_run_id",
        "expires_at"
      ],
      "type": "object"
    },
    "PriorReview": {
      "description": "直前のレビュー結果（`context.prior_review[]`）。",
      "properties": {
        "criterion": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pass": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "pass",
        "reason"
      ],
      "type": "object"
    },
    "ProviderFailure": {
      "description": "`error.provider_failure`（任意）: 供給側の失敗の種別（ADR-0010 D5, P-21）。付いていればディスパッチャは\nattempts を消費せず `requeue` し、プロバイダを cooldown にする。",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "throttled",
              "type": "string"
            },
            "retry_after_secs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "retry_after_secs"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "auth_failed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "exhausted",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ReviewOutput": {
      "description": "`Review` run がワークスペース直下 `artifacts/review.json` に書く出力（ADR-0007 D1/D5）。",
      "properties": {
        "verdicts": {
          "items": {
            "$ref": "#/$defs/ReviewVerdictOut"
          },
          "type": "array"
        }
      },
      "required": [
        "verdicts"
      ],
      "type": "object"
    },
    "ReviewRequest": {
      "description": "`Reviewer` check のための `context.review`（ADR-0007 D5）。`RunRequest.task` は合成した `Review` kind の\nタスクで、対象タスクの `run` の `done` の内容と、判定すべき条件のインデックスを渡す。",
      "properties": {
        "criteria": {
          "description": "判定すべき `task.acceptance` のインデックス（`Check::Reviewer` の条件）。",
          "items": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "evidence": {
          "description": "対象 run の `done.evidence`。",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "summary": {
          "description": "対象 run の `done.summary`。",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "evidence",
        "criteria"
      ],
      "type": "object"
    },
    "ReviewVerdictOut": {
      "description": "`artifacts/review.json` の 1 判定（ADR-0007 D1/D5）。",
      "properties": {
        "criterion": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pass": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "pass",
        "reason"
      ],
      "type": "object"
    },
    "RoleContext": {
      "description": "`context.role`（ADR-0016 D1 / M3）: タスクの役割と `[[roles]]` の指示文。アダプタはプロンプトの前置きにする。",
      "properties": {
        "id": {
          "type": "string"
        },
        "instructions": {
          "description": "設定に指示文が無ければ空。",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "RunContext": {
      "description": "`run.context`。未知フィールドは無視する（前方互換）。",
      "properties": {
        "answers": {
          "description": "`taskctl answer` で与えられた回答の履歴（時系列）。無ければ省略（ADR-0010 D3）。",
          "items": {
            "$ref": "#/$defs/Answer"
          },
          "type": "array"
        },
        "available_genres": {
          "description": "ADR-0027 D1: 委譲できる run（`build_execute_prompt` を使う run）にだけ、設定済みの分野と\nその役割の一覧を渡す。委譲できない run（`Plan`/`Review`）や `[[genres]]` が空の設定では空。",
          "items": {
            "$ref": "#/$defs/GenreContext"
          },
          "type": "array"
        },
        "children": {
          "description": "集約 run（`aggregate = true` の親の、子が全て終端になった後の run）でのみ非空（ADR-0016 D3）。",
          "items": {
            "$ref": "#/$defs/ChildSummary"
          },
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "prior_review": {
          "items": {
            "$ref": "#/$defs/PriorReview"
          },
          "type": "array"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewRequest"
            },
            {
              "type": "null"
            }
          ],
          "description": "`Reviewer` check の run でのみ `Some`（ADR-0007 D5）。"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoleContext"
            },
            {
              "type": "null"
            }
          ],
          "description": "タスクに役割があるときだけ `Some`（ADR-0016 D1）。"
        }
      },
      "required": [
        "prior_review",
        "inputs"
      ],
      "type": "object"
    },
    "Status": {
      "description": "ADR-0002 D1 の状態集合。終端は `done | failed | cancelled`。",
      "enum": [
        "draft",
        "ready",
        "running",
        "blocked",
        "reviewing",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "Task": {
      "description": "DESIGN §4.1 の `Task`。",
      "properties": {
        "acceptance": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "aggregate": {
          "description": "ADR-0016 D3: true なら、委譲した子が全て終端になった後に集約 run を 1 回だけ行い `artifacts/summary.md` を作らせる。",
          "type": "boolean"
        },
        "attempts": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "created_at": {
          "type": "string"
        },
        "depends_on": {
          "items": {
            "$ref": "#/$defs/TaskId"
          },
          "type": "array"
        },
        "genre": {
          "description": "ADR-0027 D1: 分野名（自由記述。`[[genres]] id` と一致すれば既定の役割・プロンプトの説明が効く）。\n状態機械は見ない。導入前のタスクには無いので任意。",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/TaskId"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/TaskKind"
        },
        "lease": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lease"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective": {
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "format": "int32",
          "type": "integer"
        },
        "role": {
          "description": "ADR-0016 D1: 役割名（自由記述。`[[roles]] id` と一致すれば既定と指示文が効く）。状態機械は見ない。\n導入前のタスクには無いので任意。",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "worker_hint": {
          "$ref": "#/$defs/WorkerHint"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceSpec"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "objective",
        "acceptance",
        "inputs",
        "depends_on",
        "status",
        "priority",
        "worker_hint",
        "workspace",
        "budget",
        "attempts",
        "created_at",
        "updated_at"
      ],
      "type": "object"
    },
    "TaskId": {
      "description": "タスクの一意識別子（ULID）。DESIGN §4.1。",
      "type": "string"
    },
    "TaskKind": {
      "description": "DESIGN §4.1 の `TaskKind`。",
      "enum": [
        "plan",
        "execute",
        "review",
        "approval"
      ],
      "type": "string"
    },
    "Tier": {
      "description": "DESIGN §5.4 の `WorkerHint`。",
      "enum": [
        "frontier",
        "standard",
        "cheap"
      ],
      "type": "string"
    },
    "Usage": {
      "description": "DESIGN §5.3 の `usage`。取れない項目は省略可。",
      "properties": {
        "input_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WorkerHint": {
      "properties": {
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "tier"
      ],
      "type": "object"
    },
    "WorkerMessage": {
      "description": "ワーカー → taskd のメッセージ。`done` / `error` / `question` は終端（ADR-0003 D3）。",
      "oneOf": [
        {
          "properties": {
            "msg": {
              "type": "string"
            },
            "type": {
              "const": "progress",
              "type": "string"
            }
          },
          "required": [
            "type",
            "msg"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0016 D2: 実行中の委譲の提案（任意回、非終端）。taskd は検証を通ったものだけ子タスクとして挿入し、\n拒否した提案は理由を `WorkerProgress` に残す。run は失敗しない。",
          "properties": {
            "tasks": {
              "items": {
                "$ref": "#/$defs/DelegateTask"
              },
              "type": "array"
            },
            "type": {
              "const": "delegate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tasks"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "path": {
              "description": "ワークスペース相対。絶対パス・`..`・ワークスペース外は拒否（ADR-0003 D5）。",
              "type": "string"
            },
            "type": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "question",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
              },
              "type": "array"
            },
            "summary": {
              "type": "string"
            },
            "type": {
              "const": "done",
              "type": "string"
            },
            "usage": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Usage"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "summary",
            "evidence"
          ],
          "type": "object"
        },
        {
          "properties": {
            "message": {
              "type": "string"
            },
            "provider_failure": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProviderFailure"
