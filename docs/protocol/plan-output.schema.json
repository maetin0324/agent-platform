{
  "$defs": {
    "Check": {
      "description": "DESIGN §5.3/§5.7 の `Check` 種別。",
      "oneOf": [
        {
          "properties": {
            "cmd": {
              "type": "string"
            },
            "expect_exit": {
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cmd",
            "expect_exit"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "artifact_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "reviewer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "human",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Criterion": {
      "description": "DESIGN §4.1 の `Criterion`。",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "check"
      ],
      "type": "object"
    },
    "NewTask": {
      "additionalProperties": false,
      "description": "プランナーが返す子タスク 1 件。未知フィールドは拒否する（綴り間違いの検出。ADR-0007 D2）。",
      "properties": {
        "acceptance": {
          "description": "1 件以上。`check` は DESIGN §5.7 の 4 種すべて使える。",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "assignee": {
          "description": "ADR-0033 D4（Phase 24）: 子を割り当てる組織のノード（`org_nodes.id`。SPEC §3.3「案件は組織の上から\n入り、分解されて下へ流れる」）。プランナーは普段これだけを書けばよく、`role` は必要なときだけ書く。\n`role` を書いたときは tier / adapter / 予算はその役割が勝ち、`assignee` は「誰の仕事か」だけを表す。",
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskCategory"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0044 D3（Phase 53）: 子の種類（任意。`feature|bug|research|ops|docs|other`）。\n**省略時は `other`**（人が後からボードで直せる）。状態機械は見ない。"
        },
        "depends_on": {
          "default": [],
          "description": "同じ `tasks` 配列内のインデックス。",
          "items": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "genre": {
          "description": "ADR-0028 D3: 子の分野名（任意）。明示 > `role` の分野（`roles` に含む分野がちょうど 1 つのとき）>\n親の分野の順で解決する（ADR-0027 D1 の委譲と同じ規則）。`genre` を指定して知らない分野、または\n`role` と両方指定してその役割がその分野の `roles` に無ければ、Plan run は失敗する。",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/NewTaskKind",
          "default": "execute"
        },
        "labels": {
          "description": "ADR-0044 D3（Phase 53）: 子のラベル（任意。小文字 `[a-z0-9-]`、最大 8 個）。\n規則に合わないラベルは**落とす**（計画 run を失敗させない。人がボードで直せる）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objective": {
          "type": "string"
        },
        "repos": {
          "description": "ADR-0043 D2: この子が使う案件のリポジトリを**名前で**指定する（例 `[\"benchfs\", \"benchfs-paper\"]`）。\n書かなければ **親 → 案件の primary** を継ぐ。前置きの「この案件のリポジトリ」に出ていない名前を\n書くと、その計画は差し戻される（`PlanError::UnknownRepo`）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "role": {
          "description": "ADR-0016 D1 / M10: 子の役割名（任意）。",
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tier"
            },
            {
              "type": "null"
            }
          ],
          "description": "省略時は `Standard`。"
        },
        "title": {
          "type": "string"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0039 D2: この子の作業場所（任意）。**書かなければ案件の作業場所 → 親の workspace** を継ぐので、\n別の場所（別のリポジトリ・別のクラスタ）で作業させたいときにだけ書く。"
        }
      },
      "required": [
        "title",
        "objective",
        "acceptance"
      ],
      "type": "object"
    },
    "NewTaskKind": {
      "description": "子タスクの kind。`Approval`/`Review` はプランナーからは作れない（承認ゲートは Phase 6、\nReview kind は Reviewer の合成タスク専用。ADR-0007 D2/D5）。",
      "enum": [
        "execute",
        "plan"
      ],
      "type": "string"
    },
    "TaskCategory": {
      "description": "ADR-0044 D3: タスクの種類。既定は `Other`。状態機械は見ない（人とボードのための分類）。",
      "enum": [
        "feature",
        "bug",
        "research",
        "ops",
        "docs",
        "other"
      ],
      "type": "string"
    },
    "Tier": {
      "description": "DESIGN §5.4 の `WorkerHint`。",
      "enum": [
        "frontier",
        "standard",
        "cheap"
      ],
      "type": "string"
    },
    "WorkspaceMode": {
      "description": "ADR-0041 D1: ローカルの作業場所の使い方。並列のタスクが同じ作業ツリーで `git checkout` して\n互いの未コミット変更を壊すのを止めるため、既定ではタスクごとに worktree を切る。",
      "oneOf": [
        {
          "const": "worktree",
          "description": "既定。`path` が git リポジトリなら、タスクごとに `git worktree` を切ってその中で作業する。",
          "type": "string"
        },
        {
          "const": "shared",
          "description": "従来どおり `path` をそのまま作業ディレクトリにする（自分専用の使い捨てリポジトリ向け）。",
          "type": "string"
        }
      ]
    },
    "WorkspaceSpec": {
      "description": "DESIGN §5.8 の境界。`Remote{cluster, path}` は `[[clusters]] id` と**クラスタ側の**作業ディレクトリ（ADR-0018、Phase 12）。\nceleris はその写しを `workspace_root/<task_id>` に持ち、コマンドはクラスタで実行する。",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "local",
              "type": "string"
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WorkspaceMode"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ADR-0041 D1: 省略時は `Worktree`。省略したものは JSON にも出さない（Phase 48 までの\n`{\"kind\":\"local\",\"path\":\"…\"}` と 1 バイトも変わらない）。"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "cluster": {
              "type": "string"
            },
            "kind": {
              "const": "remote",
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cluster",
            "path"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "DESIGN §5.6 の `PlanOutput{ tasks: Vec<NewTask> }`。",
  "properties": {
    "tasks": {
      "items": {
        "$ref": "#/$defs/NewTask"
      },
      "type": "array"
    }
  },
  "required": [
    "tasks"
  ],
  "title": "PlanOutput",
  "type": "object"
}
