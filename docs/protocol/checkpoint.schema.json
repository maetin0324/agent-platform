{
  "$defs": {
    "CheckpointArtifactRef": {
      "properties": {
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "CheckpointDecision": {
      "properties": {
        "what": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "what",
        "why"
      ],
      "type": "object"
    },
    "CheckpointEnd": {
      "enum": [
        "completed",
        "yielded",
        "budget_exhausted"
      ],
      "type": "string"
    },
    "CheckpointFileChange": {
      "properties": {
        "change": {
          "description": "`\"added\" | \"modified\" | \"deleted\"`（自由記述。worker の申告も daemon の git 検出もここに入る）。",
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "change"
      ],
      "type": "object"
    },
    "CheckpointKnownFailure": {
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "what": {
          "type": "string"
        }
      },
      "required": [
        "what"
      ],
      "type": "object"
    },
    "CheckpointSource": {
      "description": "checkpoint を合成した出所（D8）。",
      "enum": [
        "worker",
        "yield",
        "mechanical",
        "merged"
      ],
      "type": "string"
    },
    "CheckpointTestRun": {
      "properties": {
        "command": {
          "type": "string"
        },
        "exit": {
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "RepoState": {
      "properties": {
        "base": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "diff_stat": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "uncommitted": {
          "type": "boolean"
        }
      },
      "required": [
        "branch",
        "base",
        "head",
        "uncommitted",
        "diff_stat"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "D8: daemon が確定させた checkpoint（`celeris.checkpoint/1`）。`CheckpointSaved` イベントと\n`runs/<run_id>/checkpoint.json` に残す。",
  "properties": {
    "artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckpointArtifactRef"
      },
      "type": "array"
    },
    "completed": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckpointDecision"
      },
      "type": "array"
    },
    "end": {
      "$ref": "#/$defs/CheckpointEnd"
    },
    "files_changed": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckpointFileChange"
      },
      "type": "array"
    },
    "known_failures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckpointKnownFailure"
      },
      "type": "array"
    },
    "next_action": {
      "type": "string"
    },
    "open_questions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan_issue": {
      "type": [
        "string",
        "null"
      ]
    },
    "recent_activity": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "remaining": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "repo_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepoState"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string"
    },
    "run_seq": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/CheckpointSource"
    },
    "task_id": {
      "type": "string"
    },
    "tests_run": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckpointTestRun"
      },
      "type": "array"
    },
    "work_unit": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "task_id",
    "run_id",
    "run_seq",
    "end",
    "source",
    "next_action",
    "created_at"
  ],
  "title": "Checkpoint",
  "type": "object"
}
