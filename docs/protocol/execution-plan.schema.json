{
  "$defs": {
    "PhaseSpec": {
      "additionalProperties": false,
      "description": "ADR-0074 D1.1（Phase F2）: `celeris.execution-plan/2` の工程。配列の順が実行順（D1.1）。",
      "properties": {
        "key": {
          "description": "`[a-z0-9-]{1,32}`。計画の中で一意。",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WorkUnitKind"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title"
      ],
      "type": "object"
    },
    "WorkUnitBudget": {
      "additionalProperties": false,
      "description": "D14/D18: WU ごとの予算（任意。書かなければ D18 の既定を使う）。",
      "properties": {
        "max_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_wall_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WorkUnitCheck": {
      "additionalProperties": false,
      "description": "D14: `checks` は決定的な検査だけ（`Command`。E4 で実行する。E2 は schema と検証のみ）。",
      "properties": {
        "cmd": {
          "type": "string"
        },
        "expect_exit": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "cmd"
      ],
      "type": "object"
    },
    "WorkUnitContext": {
      "additionalProperties": false,
      "description": "D14: WU が読むべき context のヒント。",
      "properties": {
        "from_work_units": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "knowledge": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "WorkUnitKind": {
      "description": "D14: WorkUnit の種類。",
      "oneOf": [
        {
          "enum": [
            "investigate",
            "design",
            "implement",
            "test",
            "release",
            "repair",
            "other"
          ],
          "type": "string"
        },
        {
          "const": "integrate",
          "description": "ADR-0074 D1.4（Phase F2）: 工程末尾の統合 WU（daemon が計画の採用時に足す system WU。\n`runs = 0`、LLM run を起こさない）。planner の出力に書かれていれば検証で拒否する\n（`validate` の `ReservedKind`。system WU 専用の予約語）。",
          "type": "string"
        }
      ]
    },
    "WorkUnitSpec": {
      "additionalProperties": false,
      "description": "D14: 計画の中の 1 WorkUnit の spec。**`assignee` / `tier` / `model` の欄は持たない**\n（`deny_unknown_fields` により、書かれていれば schema 違反になる。D14）。",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkUnitBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkUnitCheck"
          },
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/WorkUnitContext",
          "default": {
            "from_work_units": [],
            "knowledge": [],
            "paths": []
          }
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "done_when": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "features": {
          "description": "D21: `TaskFeatures` の上書きヒント（任意の JSON。E3 以降の routing が読む）。"
        },
        "harness": {
          "description": "`[[genres]]` にある id だけを許す（D14。検証は担当の profile を知る呼び出し側が行う。\nここでは形だけ見る）。",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "`[a-z0-9-]{1,32}`。計画の中で一意（D14）。",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WorkUnitKind"
        },
        "objective": {
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phase": {
          "description": "ADR-0074 D1.1（Phase F2）: `celeris.execution-plan/2` では必須（`phases` にある key の\nいずれか）。`celeris.execution-plan/1` では無い（`Some` なら検証エラー。v1 の計画・\nプロンプトを 1 バイトも変えないため、この欄自体は常に存在するが v1 は `None` のまま）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "objective"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "D14: Planner の出力（または人が `PUT`/`POST` で書く計画）そのもの。\n\nADR-0074 D1.1（Phase F2）: `schema` の値で v1 / v2 を分ける（`validate` が判定する）。\n`phases` / `children` は v1 では常に空（`serde(default)` で省略も読める。v1 の JSON を\n1 バイトも変えないため、この 2 欄自体は型として増えるが v1 の出力・検証は変わらない）。",
  "properties": {
    "children": {
      "default": [],
      "description": "D3.7: 子 Task の提案。F4 まで空だけを許す（`validate`）。F2 の時点では中身の schema を\n決めていないので、素の JSON 値のまま持つ（今回のPhaseの先回りをしない）。",
      "items": true,
      "type": "array"
    },
    "phases": {
      "default": [],
      "description": "v2 のみ。v1 では空でなければならない（`validate`）。",
      "items": {
        "$ref": "#/$defs/PhaseSpec"
      },
      "type": "array"
    },
    "rationale": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "work_units": {
      "items": {
        "$ref": "#/$defs/WorkUnitSpec"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "rationale",
    "work_units"
  ],
  "title": "ExecutionPlanSpec",
  "type": "object"
}
